# Copy to .env and edit. Never share or commit .env.
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=False                         # True only on your own computer
DJANGO_ALLOWED_HOSTS=yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SKILLPRO_TRUST_PROXY=True                  # when behind Nginx/Apache

DB_NAME=skillpro_db
DB_USER=skillpro_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
